NODE_ENV=development
PORT=4000

# Debe coincidir con las credenciales de docker-compose.yml.
# Puerto 5433 (no 5432) para no chocar con una instalación nativa de Postgres en la máquina.
DATABASE_URL="postgresql://babylon:babylon@localhost:5433/babylon?schema=public"

JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"
# Duración de la sesión cuando se marca "Mantener sesión iniciada".
JWT_EXPIRES_IN_RECORDAR="30d"

CORS_ORIGIN="http://localhost:5173"

# Detrás de un proxy (Render, Railway, Nginx…): la cantidad de proxies delante, normalmente "1".
# No se acepta "true" (permitiría esquivar los límites de pedidos). En local, "false".
TRUST_PROXY="false"

# Correo (recuperación de contraseña). Vacío en desarrollo: los correos se
# escriben en la consola del server. Obligatorio en producción.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Babylon English Institute <no-reply@babylon.local>"
# URL pública del client, para armar los enlaces de los correos. Obligatoria en producción
# (ej. https://babylon.ejemplo.com); en desarrollo, si falta, se usa CORS_ORIGIN.
APP_URL="http://localhost:5173"
