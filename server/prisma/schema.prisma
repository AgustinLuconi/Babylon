// Schema de Prisma — un modelo por entidad de server/src/modules/**/*.entity.ts.
// Los IDs los genera la app (randomUUID() en el service) antes de llamar a
// create(), por eso ningún modelo usa @default(uuid()) en `id`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
  secretario
  profesor
  padre
}

enum EstadoUsuario {
  activo
  inactivo
  // Creada por una invitación y todavía no activada: no puede iniciar sesión.
  pendiente
}

// Un profesor solo está activo o inactivo (la cuenta de acceso, además, puede estar pendiente de activar).
enum EstadoProfesor {
  activo
  inactivo
}

// Tipo de enlace de un solo uso que se manda por correo (ver TokenCuenta).
enum TipoTokenCuenta {
  recuperacion
  invitacion
  verificacion_email
}

enum VinculoPadre {
  padre
  madre
  tutor
}

enum EstadoAlumno {
  activo
  inactivo
  egresado
}

enum NivelCurso {
  kids
  teens_a1
  teens_a2
  adults_b1
  adults_b2
  cambridge_prep
}

enum EstadoCurso {
  activo
  inactivo
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
}

enum EstadoAsistencia {
  presente
  tarde
  ausente
}

enum EstadoCuota {
  pendiente
  pagada
  vencida
}

enum MetodoPago {
  efectivo
  transferencia
  mercadopago
  otro
}

enum TipoDocumento {
  formulario_inscripcion
  copia_dni
  autorizacion_imagen
}

enum EstadoDocumento {
  pendiente
  cargado
  autorizado
  revocado
}

enum TipoAutorizacion {
  digital
  manual
}

enum TipoEvaluacion {
  examen
  trabajo_practico
  oral
  proyecto
}

enum PeriodoAcademico {
  julio
  noviembre
}

enum EscalaEvaluacion {
  numerica
  conceptual
}

enum EstadoEvaluacion {
  borrador
  publicada
}

model Ciclo {
  id     String  @id
  anio   Int     @unique
  activo Boolean

  cursos        Curso[]
  inscripciones Inscripcion[]
}

model Usuario {
  id                String        @id
  nombre            String
  email             String        @unique
  passwordHash      String
  roles             Rol[]
  estado            EstadoUsuario
  fechaCreacion     DateTime
  emailVerificadoEn DateTime?

  padre    Padre?
  profesor Profesor?

  tokens                     TokenCuenta[]
  sesiones                   Sesion[]
  notificaciones             Notificacion[]
  notificacionesDesactivadas NotificacionDesactivada[]
}

model Padre {
  id        String       @id
  nombre    String
  apellido  String
  dni       String       @unique
  direccion String?
  telefono  String?
  email     String?
  vinculo   VinculoPadre
  usuarioId String?      @unique

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  alumnos Alumno[]
  chat    Chat?
}

model Profesor {
  id        String         @id
  nombre    String
  apellido  String?
  dni       String?        @unique
  telefono  String?
  email     String?
  estado    EstadoProfesor @default(activo)
  usuarioId String?        @unique

  usuario                  Usuario?                 @relation(fields: [usuarioId], references: [id])
  cursos                   Curso[]
  categoriasPersonalizadas CategoriaPersonalizada[]
}

model Alumno {
  id                      String       @id
  nombre                  String
  apellido                String
  dni                     String       @unique
  fechaNacimiento         DateTime
  direccion               String?
  telefono                String?
  email                   String?
  foto                    String?
  observacionesMedicas    String?
  fechaInscripcion        DateTime
  estado                  EstadoAlumno
  padreId                 String?
  cursoId                 String?
  aplicaDescuentoHermanos Boolean

  padre          Padre?         @relation(fields: [padreId], references: [id])
  curso          Curso?         @relation(fields: [cursoId], references: [id])
  asistencias    Asistencia[]
  cuotas         Cuota[]
  documentos     Documento[]
  calificaciones Calificacion[]
  notasCierre    NotaCierre[]
  observaciones  Observacion[]
  inscripciones  Inscripcion[]
}

model Curso {
  id         String      @id
  nombre     String
  nivel      NivelCurso
  profesorId String
  cicloId    String
  aula       String?
  cupo       Int
  estado     EstadoCurso

  profesor                 Profesor                 @relation(fields: [profesorId], references: [id])
  ciclo                    Ciclo                    @relation(fields: [cicloId], references: [id])
  alumnos                  Alumno[]
  horarios                 Horario[]
  asistencias              Asistencia[]
  evaluaciones             Evaluacion[]
  notasCierre              NotaCierre[]
  categoriasPersonalizadas CategoriaPersonalizada[]
  inscripciones            Inscripcion[]
}

model Horario {
  id         String    @id
  cursoId    String
  diaSemana  DiaSemana
  horaInicio String
  horaFin    String

  curso Curso @relation(fields: [cursoId], references: [id])
}

model Asistencia {
  id             String           @id
  alumnoId       String
  cursoId        String
  fecha          DateTime
  estado         EstadoAsistencia
  minutosRetraso Int?
  motivo         String?

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  curso  Curso  @relation(fields: [cursoId], references: [id])

  @@unique([alumnoId, cursoId, fecha])
}

model Cuota {
  id          String      @id
  alumnoId    String
  mes         Int
  anio        Int
  montoBase   Float
  descuento   Float
  montoFinal  Float
  vencimiento DateTime
  estado      EstadoCuota

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  pago   Pago?

  // Una sola cuota por alumno y mes: hace idempotente la generación automática.
  @@unique([alumnoId, mes, anio])
}

model Pago {
  id            String     @id
  cuotaId       String     @unique
  fechaPago     DateTime
  metodo        MetodoPago
  monto         Float
  registradoPor String
  notas         String?

  cuota Cuota @relation(fields: [cuotaId], references: [id])
}

model Documento {
  id                String            @id
  alumnoId          String
  tipo              TipoDocumento
  estado            EstadoDocumento
  urlArchivo        String?
  fechaCarga        DateTime?
  autorizadoPor     String?
  fechaAutorizacion DateTime?
  tipoAutorizacion  TipoAutorizacion?

  alumno Alumno @relation(fields: [alumnoId], references: [id])

  @@unique([alumnoId, tipo])
}

model Evaluacion {
  id          String           @id
  cursoId     String
  nombre      String
  tipo        TipoEvaluacion
  fecha       DateTime
  periodo     PeriodoAcademico
  escala      EscalaEvaluacion
  estado      EstadoEvaluacion
  // Cuándo pasó a \"publicada\" (null en las publicadas antes de que existiera el campo).
  publicadaEn DateTime?

  curso          Curso          @relation(fields: [cursoId], references: [id])
  calificaciones Calificacion[]
}

model Calificacion {
  id           String  @id
  evaluacionId String
  alumnoId     String
  nota         String
  observacion  String?

  evaluacion Evaluacion @relation(fields: [evaluacionId], references: [id])
  alumno     Alumno     @relation(fields: [alumnoId], references: [id])

  @@unique([evaluacionId, alumnoId])
}

model NotaCierre {
  id          String           @id
  alumnoId    String
  cursoId     String
  periodo     PeriodoAcademico
  nota        String
  observacion String?
  estado      EstadoEvaluacion
  // Cuándo pasó a \"publicada\" (null en las publicadas antes de que existiera el campo).
  publicadaEn DateTime?

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  curso  Curso  @relation(fields: [cursoId], references: [id])

  @@unique([alumnoId, cursoId, periodo])
}

model Observacion {
  id        String   @id
  alumnoId  String
  emisorId  String
  emisorRol Rol
  fecha     DateTime
  texto     String
  categoria String

  alumno Alumno @relation(fields: [alumnoId], references: [id])
}

model CategoriaPersonalizada {
  id         String @id
  cursoId    String
  profesorId String
  nombre     String

  curso    Curso    @relation(fields: [cursoId], references: [id])
  profesor Profesor @relation(fields: [profesorId], references: [id])
}

model Inscripcion {
  id                      String   @id
  alumnoId                String
  cursoId                 String
  cicloId                 String
  fecha                   DateTime
  aplicaDescuentoHermanos Boolean

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  curso  Curso  @relation(fields: [cursoId], references: [id])
  ciclo  Ciclo  @relation(fields: [cicloId], references: [id])

  @@unique([alumnoId, cicloId])
}

model Chat {
  id       String   @id
  padreId  String   @unique
  creadoEn DateTime

  padre    Padre     @relation(fields: [padreId], references: [id])
  mensajes Mensaje[]
}

model Mensaje {
  id        String    @id
  chatId    String
  emisorId  String
  rolEmisor Rol
  texto     String
  fecha     DateTime
  // Cuándo lo vio el otro lado (nulo = todavía no). La bandeja del instituto es compartida: lo marca cualquier cuenta
  // de administración o secretaría que lee la conversación.
  vistoEn   DateTime?

  chat Chat @relation(fields: [chatId], references: [id])

  @@index([chatId, rolEmisor, vistoEn])
}

// Ajustes globales del instituto. Hay una única fila (id fijo "instituto").
model Configuracion {
  id         String @id
  // Valor de la cuota mensual, igual para todos los cursos. Sin valor cargado
  // no se generan cuotas.
  valorCuota Float?
}

// Enlace de un solo uso que se manda por correo: recuperar la contraseña (1 h), activar una invitación (7 días) o
// verificar el email (24 h). Se guarda solo el SHA-256 del token (el token viaja únicamente en el correo).
model TokenCuenta {
  id        String          @id
  usuarioId String
  tipo      TipoTokenCuenta
  hash      String          @unique
  creadoEn  DateTime
  expiraEn  DateTime
  usadoEn   DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, creadoEn])
}

// Una sesión por inicio de sesión (por dispositivo). El token lleva su id (`sid`) y solo vale mientras la
// sesión esté abierta (sin `cerradaEn`), no haya vencido (`expiraEn`) y la cuenta esté activa.
model Sesion {
  id          String    @id
  usuarioId   String
  dispositivo String
  ip          String?
  creadaEn    DateTime
  ultimoUsoEn DateTime
  expiraEn    DateTime
  cerradaEn   DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, cerradaEn, expiraEn])
}

enum TipoNotificacion {
  cuotas_vencidas
  documentacion_pendiente
  evaluacion_proxima
  asistencia_pendiente
  notas_sin_publicar
  cierre_sin_publicar
  cuota
  documentacion_hijo
  nota_publicada
  cierre_publicado
  observacion_nueva
  mensajes_familia
  mensajes_instituto
}

enum ClaseNotificacion {
  estado
  evento
}

enum TonoNotificacion {
  danger
  warning
  info
}

// Aviso de la campana, guardado para una cuenta en uno de sus roles. Los de "estado" quedan abiertos mientras la
// situación siga (resueltaEn nulo); los de "evento" ocurren una vez. `clave` identifica de qué trata (una cuota, una
// evaluación, "cuotas vencidas"…): hay a lo sumo una fila por cuenta, rol y clave. `recurso` dice a qué lleva (la
// pantalla la arma el client según el rol). `nivel` sube cuando el aviso se agrava y lo vuelve a marcar no leído.
model Notificacion {
  id            String            @id
  usuarioId     String
  rol           Rol
  tipo          TipoNotificacion
  clase         ClaseNotificacion
  clave         String
  tono          TonoNotificacion
  texto         String
  recurso       Json
  nivel         Int               @default(0)
  creadaEn      DateTime
  actualizadaEn DateTime
  leidaEn       DateTime?
  resueltaEn    DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rol, clave])
  @@index([usuarioId, rol, resueltaEn, leidaEn])
  @@index([tipo])
  @@index([actualizadaEn])
}

// Tipos de aviso que una cuenta apagó para uno de sus roles: que exista la fila quiere decir "apagado".
model NotificacionDesactivada {
  usuarioId String
  rol       Rol
  tipo      TipoNotificacion

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rol, tipo])
}
